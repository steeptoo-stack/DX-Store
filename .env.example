# Supabase Frontend Environment Variables (Safe for Client / Vite Bundle)
# Never put a Supabase service_role or secret key in any VITE_* variable.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Optional alias if using a sb_publishable_* secret name instead:
# VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Local Express dev server variables (optional when running server.ts locally)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
